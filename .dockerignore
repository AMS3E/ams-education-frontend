# Keep the build context small and the image reproducible. Anything generated
# on the host must be regenerated inside the image, never copied in.
node_modules
.next
out
build
.git
.gitignore
.vercel
.claude

# Panda output — regenerated by `panda codegen` (the `prepare` script). The
# real outdir is src/styled-system; unlike .gitignore, a bare name here does NOT
# match at depth, so both levels are spelled out.
**/styled-system
**/styled-system-studio

# Never ship host secrets into an image layer.
.env
.env.*

# Not needed to build or serve.
docs
temp
coverage
*.md
!README.md
*.log
*.tsbuildinfo
